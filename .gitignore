# Generated large data (recreated by scripts/refresh_data.py)
apps/tech-growth-map/public/data/pcn_icb_mapping.json

# Planner dashboard data — INTERNAL CS/sales (deal owners + emails, ARR, contract
# amounts, CS notes, blockers). Generated fresh in CI by deploy-planner-cf.yml and
