fetch_practices.sh
geocode_practices.py
page1.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Reference docs — ignore ad-hoc workbooks, keep the NHS ICB merger source
# file which is load-bearing for scripts/icb_mapper.py (Frimley resolution).
*.xlsx
!ODS+Change+Summary+ICB+Mergers+Phase+1+Apr+2026 (2).xlsx

